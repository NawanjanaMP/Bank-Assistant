# Copy to .env and fill in. Never commit .env. In Kubernetes these come from Secrets / Vault.
BANKAI_ENV=local
BANKAI_LOG_LEVEL=INFO

# --- Identity: oidc (Keycloak in compose) or dev (local only, refused in staging/prod)
BANKAI_AUTH_MODE=oidc
BANKAI_OIDC_ISSUER=http://localhost:8080/realms/bank
# Inside compose the API reaches Keycloak by service name while tokens carry the public issuer:
BANKAI_OIDC_JWKS_URL=http://keycloak:8080/realms/bank/protocol/openid-connect/certs
BANKAI_OIDC_AUDIENCE=bank-assistant-api
WEB_AUTH_MODE=oidc

# --- Secrets (generate fresh values per environment)
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
BANKAI_CONTEXT_TOKEN_SIGNING_KEY=replace-with-48-random-bytes-0123456789abcdefghij
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
BANKAI_PII_VAULT_KEY=
BANKAI_CORE_BANKING_API_KEY=dev-core-banking-key
REDIS_PASSWORD=devpassword
POSTGRES_PASSWORD=bankai

# --- Data stores
BANKAI_REDIS_URL=redis://:devpassword@redis:6379/0
BANKAI_DATABASE_URL=postgresql+asyncpg://bankai:bankai@postgres:5432/bankai

# --- LLMs: anthropic (third-party) primary, self-hosted fallback.
# Leave the key empty and set BANKAI_LLM_PRIMARY=simulator for a keyless demo.
BANKAI_ANTHROPIC_API_KEY=
BANKAI_LLM_PRIMARY=anthropic
BANKAI_LLM_FALLBACK=self_hosted
BANKAI_COORDINATOR_MODEL=claude-haiku-4-5-20251001
BANKAI_SPECIALIST_MODEL=claude-sonnet-5
BANKAI_SELF_HOSTED_BASE_URL=http://ollama:11434/v1
BANKAI_SELF_HOSTED_MODEL=qwen2.5:14b-instruct
# Agents whose prompts must never leave the bank network (JSON list), e.g. ["service"]
BANKAI_SELF_HOSTED_ONLY_AGENTS=[]

# --- MCP servers and core banking
BANKAI_MCP_ACCOUNTS_URL=http://mcp-accounts:9101/mcp
BANKAI_MCP_TRANSACTIONS_URL=http://mcp-transactions:9102/mcp
BANKAI_MCP_SERVICE_URL=http://mcp-service:9103/mcp
BANKAI_CORE_BANKING_URL=http://core-banking:9200

# --- Limits
BANKAI_USER_RATE_LIMIT_PER_MINUTE=20
BANKAI_SESSION_COST_LIMIT_USD=0.50
BANKAI_USER_DAILY_COST_LIMIT_USD=5.00

# --- Observability
BANKAI_OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318
BANKAI_CORS_ORIGINS=["http://localhost:8443","http://localhost:5173"]
